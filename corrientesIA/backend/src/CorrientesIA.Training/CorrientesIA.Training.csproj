<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Bindings oficiales de C# sobre libtorch. Motor real de autodiff/tensores. -->
    <PackageReference Include="TorchSharp" Version="0.102.7" />
    <!-- Paquete nativo para CPU. Si despues conseguis GPU con CUDA, se cambia por TorchSharp-cuda-* -->
    <PackageReference Include="libtorch-cpu" Version="2.2.1.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CorrientesIA.Data\CorrientesIA.Data.csproj" />
  </ItemGroup>
</Project>
